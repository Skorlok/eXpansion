<frame posn="0 0 2.0" id="Frame">
    <frame>
        <exp:widgettitle sizeX="37" sizeY="4" text="{@{title}}"/>
    </frame>
    <quad posn="2 -4.2 3.0E-5" sizen="30 4" style="BgsPlayerCard" substyle="BgCardSystem"/>
    <quad posn="26 -4.2 4.0E-5" sizen="4 4" style="Icons64x64_1" substyle="ArrowNext" action="exp:eXpansion.ServerNeighborhood:showServerList"/>
    <label posn="26 -5.2 5.0E-5" sizen="20 4" scale="0.6" halign="right" valign="top" style="TextStaticSmall" action="exp:eXpansion.ServerNeighborhood:showServerList" textid="{@$FFFShow All}"/>
    <label id="ode8_sn_SecCounter" posn="5 -5.2 6.0E-5" sizen="5 4" scale="0.6" halign="left" valign="top" style="TextStaticSmall" text="$FFF{refresh_interval}"/>
    <quad id="minimizeButton" posn="33 0 7.0E-5" sizen="5 5" style="Icons128x128_1" substyle="ServersAll" scriptevents="1"/>
    <frame posn="0 -8.2 8.0E-5">
        <exp:if test="isUndefStyle">
            <exp:foreach items="servers" as="s">
            <frame posn="0 {s.posY} 0">
                <quad sizen="30 5.8" halign="left" valign="top" style="BgsPlayerCard" substyle="BgCardSystem" action="{s.action}"/>
                <quad posn="27.8 -0.2 1.0E-5" sizen="5.4 5.4" style="{s.iconStyle}" substyle="{s.iconSubstyle}"/>
                <quad posn="26 -0.4 2.0E-5" sizen="3 3" style="Icons128x32_1" substyle="{s.modeSubstyle}"/>
                <quad posn="2.5 -2.8 3.0E-5" sizen="2.5 2.5" style="Icons64x64_1" substyle="Buddy"/>
                <label posn="4.5 -3.3 4.0E-5" sizen="10 5.4" scale="0.5" style="TextStaticSmall" text="{s.players}"/>
                <quad posn="13 -2.8 5.0E-5" sizen="2.5 2.5" style="Icons64x64_1" substyle="IconPlayers"/>
                <label posn="15 -3.3 6.0E-5" sizen="10 5.4" scale="0.5" style="TextStaticSmall" text="{s.specs}"/>
                <quad posn="22 -2.8 7.0E-5" sizen="2.5 2.5" style="Icons64x64_1" substyle="ToolLeague1"/>
                <label posn="24 -3.3 8.0E-5" sizen="10 5.4" scale="0.5" style="TextStaticSmall" text="{s.ladder}"/>
                <label posn="2 -0.6 9.0E-5" sizen="38 4" scale="0.6" halign="left" valign="top" style="TextStaticSmall" text="{s.name}"/>
            </frame>
            </exp:foreach>
        <exp:else/>
            <exp:foreach items="servers" as="s">
            <frame posn="0 {s.posY} 0">
                <quad sizen="30 3.4" halign="left" valign="top" style="BgsPlayerCard" substyle="BgCardSystem" action="{s.action}"/>
                <label posn="1 -0.5 1.0E-5" sizen="48 4" scale="0.6" halign="left" valign="top" style="TextStaticSmall" text="{s.name}"/>
            </frame>
            </exp:foreach>
        </exp:if>
    </frame>
    <frame>
        <exp:widgetbg sizeX="33" sizeY="{bgSizeY}"/>
    </frame>
</frame>
