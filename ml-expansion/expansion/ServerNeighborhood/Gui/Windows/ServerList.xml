<?php

$servers = $this->getParam("servers");

$itemsXml = "";

foreach ((array)$servers as $server) {
    $isFullPlayers    = ((int)$server['playersCurrent'] >= (int)$server['playersMax']);
    $infoColorPlayers = $isFullPlayers ? 'F00' : '111';

    $isFullSpecs      = ((int)$server['specsCurrent'] >= (int)$server['specsMax']);
    $infoColorSpecs   = $isFullSpecs ? 'F00' : '111';

    $itemsXml .= '<frame>';

    // Left side: server info — frame_main at (0,7), server_frame at (3,-1) within
    $itemsXml .= '<frame posn="0 7 0">';
    $itemsXml .= '<frame posn="3 -1 0">';
    $itemsXml .= '<label sizen="20 4.66666666667" scale="0.8" style="TextStaticSmall" text="$111$i' . $this->handleSpecialChars($server['env']) . '"/>';
    $itemsXml .= '<label posn="0 -3.73333333334 0" sizen="50 4.66666666667" halign="left" valign="top" style="TextRaceMessageBig" textsize="2" text="' . $this->handleSpecialChars($server['sname']) . '"/>';
    $itemsXml .= '<frame posn="0 -8.4 0" scale="0.8">';
    $itemsXml .= '<quad posn="0 0 0.1" sizen="4.66666666667 4.66666666667" style="Icons64x64_1" substyle="Buddy"/>';
    $itemsXml .= '<label posn="4.66666666667 0 0" sizen="14 9" style="TextStaticSmall" textcolor="' . $infoColorPlayers . '" text="' . $server['playersCurrent'] . '/' . $server['playersMax'] . '"/>';
    $itemsXml .= '<quad posn="18.6666666667 0 0.1" sizen="4.66666666667 4.66666666667" style="Icons64x64_1" substyle="IconPlayers"/>';
    $itemsXml .= '<label posn="23.3333333333 0 0" sizen="14 9" style="TextStaticSmall" textcolor="' . $infoColorSpecs . '" text="' . $server['specsCurrent'] . '/' . $server['specsMax'] . '"/>';
    $itemsXml .= '<quad posn="37.3333333333 0 0.1" sizen="4.66666666667 4.66666666667" style="Icons128x128_1" substyle="LadderPoints"/>';
    $itemsXml .= '<label posn="42 0 0" sizen="14 4.66666666667" style="TextStaticSmall" textcolor="111" text="' . $server['ladderMin'] . ' - ' . $server['ladderMax'] . 'k"/>';
    $itemsXml .= '</frame>';
    $itemsXml .= '</frame>';
    $itemsXml .= '</frame>';

    // Right side: map info at (108, 6)
    $itemsXml .= '<frame posn="108 6 0">';
    $itemsXml .= '<label sizen="50 4.66666666667" halign="right" valign="top" style="TextRaceMessageBig" textsize="2" text="$111' . $this->handleSpecialChars($server['mapName']) . '"/>';
    $itemsXml .= '<label posn="0 -4.66666666667 0" sizen="20 4.66666666667" halign="right" valign="top" style="TextStaticSmall" text="$111' . $this->handleSpecialChars($server['mapAuthor']) . '"/>';
    $itemsXml .= '<label posn="0 -9.33333333334 0" sizen="20 4.66666666667" halign="right" valign="top" style="TextStaticSmall" textsize="1" text="$111' . $this->handleSpecialChars($server['mapAuthorTime']) . '"/>';
    $itemsXml .= '</frame>';

    // Full-item clickable button overlay at (0, 7) matching the Y+7 shift of bg_main
    $itemsXml .= '<frame posn="0 0 0" scale="1.333333333">';
    $itemsXml .= '<exp:icon sizeX="108" sizeY="11.5" description="Click to show more info" descSizeX="40" action="' . $server['action'] . '" icon="Bgs1" iconSub="BgCardOnline"/>';
    $itemsXml .= '</frame>';

    $itemsXml .= '</frame>';
}

$this->setParam("itemsXml", $itemsXml);
?>
