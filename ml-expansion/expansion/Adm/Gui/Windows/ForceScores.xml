    $itemsXml .= '<exp:inputbox name="' . $player->login . '" sizeX="20"/>';
    $itemsXml .= '</frame>';
    $itemsXml .= '</frame>';
    $itemsXml .= '</frame>';
    $i++;
}

$this->setParam("itemsXml", $itemsXml);
