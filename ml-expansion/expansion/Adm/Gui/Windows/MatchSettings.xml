<?php
$files    = $this->getParam("files");
$isRemote = $this->getParam("isRemote");
$perms    = $this->getParam("perms");

$sizeX      = 158;  // window 160 - 2 (pager setSize sizeX-2)
$pagerSizeY = 84;   // window 100 - 16 (pager setSize sizeY-16)
$itemSizeY  = 6;
$itemWidth  = 152;  // pager frame width = sizeX-6

$itemsXml = "";
$i = 0;

if ($isRemote) {
    $itemsXml .= '<frame>';
    $itemsXml .= '<exp:listbg indexNumber="' . $i . '" sizeX="' . $itemWidth . '" sizeY="' . $itemSizeY . '"/>';
    $itemsXml .= '<frame posn="2 0 1.0E-5"><label sizen="148 4" halign="left" valign="center" style="TextCardSmallScores2" textsize="1" textcolor="fff" textid="' . $this->addLang("File listing disabled since you are running remote") . '"/></frame>';
    $itemsXml .= '</frame>';
    $i++;
    $itemsXml .= '<frame>';
    $itemsXml .= '<exp:listbg indexNumber="' . $i . '" sizeX="' . $itemWidth . '" sizeY="' . $itemSizeY . '"/>';
    $itemsXml .= '<frame posn="2 0 1.0E-5"><label sizen="148 4" halign="left" valign="center" style="TextCardSmallScores2" textsize="1" textcolor="fff" textid="' . $this->addLang("You can tho save and load files from server by the filename!") . '"/></frame>';
    $itemsXml .= '</frame>';
} else {
    foreach ((array)$files as $file) {
        $itemsXml .= '<frame>';
        $itemsXml .= '<exp:listbg indexNumber="' . $i . '" sizeX="' . $itemWidth . '" sizeY="' . $itemSizeY . '"/>';
        $itemsXml .= '<frame posn="2 0 1.0E-5">';
        $itemsXml .= '<quad sizen="4 4" halign="center" valign="center2" style="Icons128x128_1" substyle="Challenge"/>';
        $itemsXml .= '<label posn="4 0 1.0E-5" sizen="90 4" halign="left" valign="center" style="TextCardSmallScores2" textsize="1" textcolor="fff" text="' . $this->handleSpecialChars($file['basename']) . '"/>';
        $itemsXml .= '<quad posn="94 0 2.0E-5" sizen="4 4" style="Empty" substyle="BgWindow2"/>';
        if ($perms['canLoad']) {
            $itemsXml .= '<frame posn="98 0 3.0E-5" scale="0.8">';
            $itemsXml .= '<exp:button sizeX="26" sizeY="5" text="@Load" colorize="A54B4B" action="' . $file['load'] . '" isTextId="true"/>';
            $itemsXml .= '</frame>';
        }
        if ($perms['canSave']) {
            $itemsXml .= '<frame posn="114.8 0 3.0E-5" scale="0.8">';
            $itemsXml .= '<exp:button sizeX="26" sizeY="5" text="@Save" colorize="0d0" action="' . $file['save'] . '" isTextId="true"/>';
            $itemsXml .= '</frame>';
        }
        if ($perms['canDelete']) {
            $itemsXml .= '<frame posn="131.6 0 3.0E-5" scale="0.8">';
            $itemsXml .= '<exp:button sizeX="26" sizeY="5" text="@Delete" colorize="d00" action="' . $file['delete'] . '" isTextId="true"/>';
            $itemsXml .= '</frame>';
        }
        $itemsXml .= '</frame>';
        $itemsXml .= '</frame>';
        $i++;
    }
}
?>
<?php if ($perms['canSaveAs']): ?>
<frame posn="4 -4 0">
	<frame posn="0 0 1">
		<exp:inputbox name="SaveAs" sizeX="40" label="@Save MatchSettings as" isTextId="true"/>
	</frame>
	<frame posn="42 0 0">
		<exp:button sizeX="32" sizeY="6" text="@Save" colorize="d00" action="exp:eXpansion.Adm:matchSettingsSaveAs" isTextId="true"/>
	</frame>
	<frame posn="69.5 0 1">
		<exp:inputbox name="LoadAs" sizeX="40" label="@Load MatchSettings by name" isTextId="true"/>
	</frame>
	<frame posn="111.5 0 0">
		<exp:button sizeX="32" sizeY="6" text="@Load" colorize="0d0" action="exp:eXpansion.Adm:matchSettingsLoadAs" isTextId="true"/>
	</frame>
</frame>
<?php endif; ?>
<?php echo \ManiaLivePlugins\eXpansion\Gui\Elements\Pager::getXML($sizeX, $pagerSizeY, $itemsXml, 0, -6); ?>
