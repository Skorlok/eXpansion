    $itemsXml .= '</frame>';
    $itemsXml .= '</frame>';
    $itemsXml .= '</frame>';
    $i++;
}
?>
<?php echo \ManiaLivePlugins\eXpansion\Gui\Elements\Pager::getXML($sizeX, $pagerSizeY, $itemsXml, 0, 0); ?>
