$itemSizeY  = 6;
$itemWidth  = 152;  // sizeX - 8

$itemsXml = "";

// Row 0: custom points input
$itemsXml .= '<frame>';
$itemsXml .= '<exp:listbg indexNumber="0" sizeX="' . $itemWidth . '" sizeY="' . $itemSizeY . '"/>';
