$itemsXml .= '<frame posn="40 0 1">';
$itemsXml .= '<exp:inputbox name="customPoints" sizeX="90" text="' . $customPoints . '"/>';
$itemsXml .= '</frame>';
$itemsXml .= '<frame posn="130 0 5.0E-5" scale="0.8">';
