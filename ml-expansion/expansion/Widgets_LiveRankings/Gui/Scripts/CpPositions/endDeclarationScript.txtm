
declare Integer totalCp = {{ totalCp }};
declare Integer nbFields =  {{ nbFields }};
declare Integer nbFirstFields =  {{ nbFirstFields }};

//Ranks of the players
declare playerTimes	= {{ playerTimes }};
declare playerNickNames	= {{ nickNames }};
declare bestCps	= {{ bestCps }};

//The latest checkpoint the player past
declare playersOnServer = Text[Text];
declare playersTeam = {{ playerTeams }};
declare maxCp = {{ maxCp }};

declare Boolean needUpdate = True;
declare lastUpdateTime = 0;
declare lastTimeDiff = Integer[Text];

declare nbFinish = 0;

//Gui staff
declare Boolean givePoints = {{ givePoints }};
declare points = {{ points }};
declare isLaps = {{ isLaps }};
declare nbLaps = {{ nbLaps }};

declare isTeam = {{ isTeam }};
declare team1Color = "{{ team1Color }}";
declare team2Color = "{{ team2Color }}";

declare maxPoint = {{ maxPoint }};

declare Text[] playerScoreRanks;
declare updatedPlayers = Boolean[Text];

declare currentPlayerName = "";
declare prevPlayerName = "";






declare MicroMenu = (Page.GetFirstChild("MicroMenu") as CMlFrame);
MicroMenu.RelativePosition.Z = 30.0;
declare Integer itemCount = 2;

declare persistent Boolean[Text] showMenu = Boolean[Text];
declare hideStamp = 0;
declare showStamp = 0;

if (!showMenu.existskey(id)) {
	showMenu[id] = False;
}

if (showMenu[id]) {

    for (i, 1, itemCount ) {
        declare quad = (Page.GetFirstChild("mQuad_"^i) as CMlQuad);
        declare item = (Page.GetFirstChild("item_"^i) as CMlLabel);

        quad.Opacity = 0.75;
        item.Opacity = 1.0;
    }

    MicroMenu.Show();

} else {
    
    for (i, 1, itemCount ) {
        declare quad = (Page.GetFirstChild("mQuad_"^i) as CMlQuad);
        declare item = (Page.GetFirstChild("item_"^i) as CMlLabel);

        quad.Opacity = 0.0;
        item.Opacity = 0.0;
    }

    MicroMenu.Hide();

}