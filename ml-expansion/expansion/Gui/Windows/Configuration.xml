<?php
use ManiaLivePlugins\eXpansion\Gui\Elements\Pager;

$items       = $this->getParam("items");
$sizeX       = (int)$this->getParam("sizeX");
$sizeY       = (int)$this->getParam("sizeY");

$pagerSizeX = $sizeX;
$pagerSizeY = $sizeY - 8;
$applyPosX  = $sizeX - 26;
$applyPosY  = -($sizeY - 5);

$itemsXml = "";
$n        = 0;

foreach ((array)$items as $item) {
    $itemsXml .= '<frame>';
    $itemsXml .= '<frame posn="0 0 1">';
    $itemsXml .= '<exp:checkbox name="cb_' . $n . '" active="' . ((bool)$item['value'] ? 'true' : 'false') . '" textWidth="50" text="' . $this->handleSpecialChars($item['id']) . '"/>';
    $itemsXml .= '</frame>';
    $itemsXml .= '</frame>';
    $n++;
}
?>
<?php echo Pager::getXML($pagerSizeX, $pagerSizeY, $itemsXml, 0, 0); ?>
<frame posn="<?php echo $applyPosX; ?> <?php echo $applyPosY; ?> 1">
    <exp:button sizeX="32" sizeY="6" text="@Apply" colorize="0D0" action="exp:eXpansion.Gui:configurationOk" isTextId="true"/>
</frame>
