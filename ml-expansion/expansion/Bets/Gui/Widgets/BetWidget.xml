<exp:widgetbg sizeX="80" sizeY="19.75"/>
<frame posn="0 0 1">
    <exp:widgettitle sizeX="80" sizeY="4" text="@Start Bet"/>
</frame>
<frame posn="1 -8 0">
	<frame>
		<frame>
			<frame posn="0 0 1">
                <exp:button sizeX="20" sizeY="6" text="25" colorize="3af" action="exp:eXpansion.Bets:setBetAmount:25"/>
			</frame>
			<frame posn="16.5 0 1">
				<exp:button sizeX="20" sizeY="6" text="50" colorize="3af" action="exp:eXpansion.Bets:setBetAmount:50"/>
			</frame>
			<frame posn="33 0 1">
				<exp:button sizeX="20" sizeY="6" text="100" colorize="3af" action="exp:eXpansion.Bets:setBetAmount:100"/>
			</frame>
			<frame posn="0 -6 1">
				<exp:button sizeX="20" sizeY="6" text="250" colorize="3af" action="exp:eXpansion.Bets:setBetAmount:250"/>
			</frame>
			<frame posn="16.5 -6 1">
				<exp:button sizeX="20" sizeY="6" text="500" colorize="3af" action="exp:eXpansion.Bets:setBetAmount:500"/>
			</frame>
			<frame posn="32 -6 1">
                <exp:inputbox name="betAmount" sizeX="18"/>
			</frame>
		</frame>
	</frame>
</frame>
<frame posn="52 -15 1">
    <exp:button sizeX="32" sizeY="6" text="Close" id="closeButton"/>
</frame>
<frame posn="52 -8 1">
    <exp:button sizeX="32" sizeY="6" text="Accept" colorize="0d0" action="exp:eXpansion.Bets:setBetAmount:0"/>
</frame>
