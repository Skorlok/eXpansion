<?php

$groups    = $this->getParam("groups");

$itemsXml = "";
$n = 0;

foreach ((array)$groups as $group) {
    $itemsXml .= '<frame>';
    $itemsXml .= '<exp:listbg indexNumber="' . $n . '" sizeX="74" sizeY="4"/>';
    $itemsXml .= '<frame posn="0 0 1">';
    $itemsXml .= '<exp:checkbox name="cb_' . $group['name'] . '" active="' . ((bool)$group['checked'] ? 'true' : 'false') . '" textWidth="60" text="' . $this->handleSpecialChars($group['name']) . '"/>';
    $itemsXml .= '</frame>';
    $itemsXml .= '</frame>';
    $n++;
}

$this->setParam("itemsXml", $itemsXml);
?>
<exp:pager sizeX="78" sizeY="88" itemsVarName="itemsXml" posX="0" posY="0" itemSizeY="4"/>
<frame posn="32 -95 1">
    <exp:button sizeX="32" sizeY="6" text="@OK" action="exp:eXpansion.AdminGroups:inheritsOk:{groupName}" isTextId="true"/>
</frame>
