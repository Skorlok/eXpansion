<frame>
    <exp:foreach items="groups" as="group" index="idx">
    <frame posn="0 -{group.posY} 1">
        <exp:if test="group.selected">
            <exp:button sizeX="32" sizeY="6" text="{group.name}" colorize="0b0" action="exp:eXpansion.AutoLoad:pluginListSetGroup:{idx}"/>
        <exp:else/>
            <exp:button sizeX="32" sizeY="6" text="{group.name}" action="exp:eXpansion.AutoLoad:pluginListSetGroup:{idx}"/>
        </exp:if>
    </frame>
    </exp:foreach>
</frame>
<frame posn="33 -2 0">
    <frame id="Pager" scriptevents="1">
        <exp:foreach items="plugins" as="plugin">
        <frame>
            <exp:listbg indexNumber="{plugin.index}" sizeX="134" sizeY="8"/>
            <frame posn="0 0 1">
                <exp:icon sizeX="8" sizeY="8" description="{plugin.toggleTooltip}" descSizeX="100" colorize="{plugin.toggleColorize}" action="exp:eXpansion.AutoLoad:pluginListToggle:{plugin.id}" icon="Icons64x64_1" iconSub="GenericButton"/>
            </frame>
            <label posn="8 3 2.0E-5" sizen="76 4" style="TextStaticSmall" textsize="2" text="{plugin.name}"/>
            <label posn="8 -0.5 3.0E-5" sizen="76 4" style="TextCardScores2" textsize="1" text="$i{plugin.desc}"/>
            <frame posn="102 0 1">
                <exp:icon sizeX="7" sizeY="7" description="{plugin.titleTooltip}" descSizeX="100" colorize="{plugin.titleColorize}" icon="Icons64x64_1" iconSub="GenericButton"/>
            </frame>
            <frame posn="108 0 1">
                <exp:icon sizeX="7" sizeY="7" description="{plugin.gameTooltip}" descSizeX="100" colorize="{plugin.gameColorize}" icon="Icons64x64_1" iconSub="GenericButton"/>
            </frame>
            <frame posn="114 0 1">
                <exp:icon sizeX="7" sizeY="7" description="{plugin.otherTooltip}" descSizeX="100" descSizeY="{plugin.otherSizeY}" descLines="3" colorize="{plugin.otherColorize}" icon="Icons64x64_1" iconSub="GenericButton"/>
            </frame>
            <exp:if test="plugin.configAvailable">
                <frame posn="84 0 1">
                    <exp:button sizeX="22" sizeY="7" text="@Settings" action="exp:eXpansion.AutoLoad:pluginListShowConfig:{plugin.id}" isTextId="true"/>
                </frame>
            </exp:if>
            <frame posn="121 0 1">
                <exp:button sizeX="14" sizeY="7" text="{@{plugin.startText}}" colorize="{plugin.startColorize}" action="exp:eXpansion.AutoLoad:pluginListToggle:{plugin.id}" isTextId="true"/>
            </frame>
        </frame>
        </exp:foreach>
    </frame>
    <exp:pager sizeX="139" sizeY="86" itemSizeY="8"/>
</frame>
<frame posn="33 -1 0.00127">
	<frame>
		<frame posn="0 0 1">
			<exp:inputbox name="name" sizeX="35" label="@Name" text="{currentName}" isTextId="true"/>
		</frame>
		<frame posn="37 0 1">
			<exp:inputbox name="author" sizeX="35" label="@Author" text="{currentAuthor}" isTextId="true"/>
		</frame>
		<frame posn="74 0 1">
			<exp:dropdown name="group" itemsVarName="groupNames" selectedIndex="{currentGroupIdx}" sizeX="25"/>
		</frame>
		<frame posn="101 0 1">
			<exp:button sizeX="32" sizeY="6" text="@Search" action="exp:eXpansion.AutoLoad:pluginListSearch" isTextId="true"/>
		</frame>
	</frame>
</frame>
