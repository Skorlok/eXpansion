<frame>
    <exp:foreach items="runs" as="run">
    <frame posn="0 {run.posY} 0">
        <quad posn="-1 0 0" sizen="45 5" halign="left" valign="center" style="BgsPlayerCard" substyle="BgRacePlayerName" colorize="{bgColorize}"/>
        <label posn="0 0 1.0E-5" sizen="30 3" halign="left" valign="center" style="TextStaticSmall" textsize="1" text="{run.nickname}"/>
        <label posn="32 0 2.0E-5" sizen="13 3" halign="left" valign="center" style="TextStaticSmall" textsize="1" textcolor="{timeColor}" text="{run.time}"/>
        <frame posn="52 0 0">
            <exp:foreach items="run.checkpoints" as="cp">
            <frame posn="{cp.posX} 0 0">
                <quad posn="-7.5 0 0" sizen="15 5" halign="left" valign="center" style="BgsPlayerCard" substyle="BgRacePlayerName" colorize="{bgColorize}"/>
                <label sizen="15 5" halign="center" valign="center" style="TextStaticSmall" textsize="1" text="{cp.text}"/>
            </frame>
            </exp:foreach>
        </frame>
    </frame>
    </exp:foreach>
</frame>
