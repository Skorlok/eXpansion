<frame posn="20 0 0">
    <label posn="0 0 0" sizen="32 7" scale="0.7" halign="right" valign="top" style="TextStaticSmall" textcolor="ddd" textid="{@Personal Best}"/>
    <label posn="1 0 0" sizen="16 4" scale="0.7" halign="left" valign="top" style="TextStaticSmall" textcolor="ddd" text="{pbTime}" id="pbTime"/>
    <label posn="0 -3 0" sizen="32 7" scale="0.7" halign="right" valign="top" style="TextStaticSmall" textcolor="ddd" textid="{@Average}"/>
    <label posn="1 -3 0" sizen="16 4" scale="0.7" halign="left" valign="top" style="TextStaticSmall" textcolor="ddd" text="{avgTime}" id="avgTime"/>
    <label posn="0 -6 0" sizen="32 7" scale="0.7" halign="right" valign="top" style="TextStaticSmall" textcolor="ddd" textid="{@Finishes}"/>
    <label posn="1 -6 0" sizen="16 4" scale="0.7" halign="left" valign="top" style="TextStaticSmall" textcolor="ddd" text="{nbFinish}" id="nbFinish"/>
    <label posn="0 -9 0" sizen="32 7" scale="0.7" halign="right" valign="top" style="TextStaticSmall" textcolor="ddd" textid="{@Server Rank}"/>
    <label posn="1 -9 0" sizen="16 4" scale="0.7" halign="left" valign="top" style="TextStaticSmall" textcolor="ddd" text="{rank}$n $m/$n $m{rankTotal}" id="rank"/>
</frame>
