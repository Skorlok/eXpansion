foreach (Event in PendingEvents) {
    if (Event.Type == CMlEvent::Type::MouseClick && Event.ControlId == "{{ name }}l") {
        Frame{{ dropdownIndex }}.Show();
    } else {
        if (Event.Type == CMlEvent::Type::MouseClick) {
            Frame{{ dropdownIndex }}.Hide();
        }
    }
    {{ itemHandlers }}
}
