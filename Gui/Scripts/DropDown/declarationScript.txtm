declare CMlFrame Frame{{ dropdownIndex }} <=> (Page.GetFirstChild("{{ name }}f") as CMlFrame);
declare CMlLabel Label{{ dropdownIndex }} <=> (Page.GetFirstChild("{{ name }}l") as CMlLabel);
declare CMlEntry Output{{ dropdownIndex }} <=> (Page.GetFirstChild("{{ name }}e") as CMlEntry);
Frame{{ dropdownIndex }}.Hide();

Output{{ dropdownIndex }}.Value = "{{ selected }}";
