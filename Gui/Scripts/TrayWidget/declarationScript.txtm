declare mainWindow <=> Page.GetFirstChild("Frame");
declare isMinimized = {{ isMinimized }};                                          
declare isAnimation = False;                                          

declare lastAction = Now;
declare autoCloseTimeout = {{ autoCloseTimeout }};
declare disableAutoClose = False;
declare positionMin = {{ posXMin }};
declare positionMax = {{ posXMax }};
mainWindow.RelativePosition.X = {{ posX }};

if(autoCloseTimeout <= 0){
    disableAutoClose = True;
}
