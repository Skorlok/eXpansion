<manialink id="{widgetHashName}" version="2" layer="{layer}" name="{widgetName}">
{languages}
<frame posn="0 0 -60" id="{widgetName}">

<frame posn="0 0 -0.1" id="windowFrame">
<quad posn="-6 0 0" sizen="{frameSize}" halign="left" valign="top" bgcolor="{windowBgColor}" opacity="0.9"/>
<quad id="MainWindow" posn="-6 -{contentH} 1.0E-5" sizen="{frameW} 6" halign="right" valign="bottom" opacity="0.9" image="file://Media/Manialinks/Common/Home/maniahome-title.dds" rot="-180"/>
<quad id="MainWindow" posn="-6 6 2.0E-5" sizen="{fullFrameSize}" halign="left" valign="top" style="Bgs1" substyle="BgColorContour" scriptevents="1" modulatecolor="{windowTitleBgColor}"/>
<quad posn="-6 6 3.0E-5" sizen="{frameW} 6" halign="left" valign="top" bgcolor="{windowTitleBgColor}" opacity="0.8"/>
<label id="TitlebarText" posn="0 1 4.0E-5" sizen="{labelW} 4" halign="left" valign="bottom" style="TextRaceMessageBig" textsize="1" textcolor="{windowTitleColor}" textid="{title}"/>
<quad id="Titlebar" posn="-6 6 5.0E-5" sizen="{frameW} 6" halign="left" valign="top" style="Bgs1" substyle="BgColorContour" scriptevents="1" modulatecolor="{windowTitleBgColor}"/>
<quad id="Close" posn="{closeX} 1 5" sizen="4 4" halign="right" valign="bottom" image="file://Media/Manialinks/Common/Chat/buddy-buddy-deny-focus.dds" imagefocus="file://Media/Manialinks/Common/Chat/buddy-buddy-deny.dds" scriptevents="1"/>
</frame>

<frame posn="0 -7 7.0E-5">
{xml}
</frame>

<script>
<!--
{mlScripts}
-->
</script>

</frame>
</manialink>
