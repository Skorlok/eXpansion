<frame posn="0 0 0">
    <exp:widgetbg sizeX="40" sizeY="{bgSizeY}"/>
</frame>
<frame posn="0 0 1">
    <exp:widgettitle sizeX="40" sizeY="4" text="{@{title}}"/>
</frame>
<frame posn="4 -5 0">
    <frame>
        <exp:foreach items="rows" as="r">
        <frame posn="0 {r.posY} 0">
            <exp:if test="r.isPlaytime">
                <label posn="14 0 0" sizen="20 4" scale="0.75" halign="left" valign="center" style="TextRaceChat" textcolor="fff" text="{r.nickname}"/>
                <label posn="13 0 1.0E-5" sizen="20 5" scale="0.75" halign="right" valign="center" style="TextRaceChat" textcolor="ff0" text="{r.value}"/>
            <exp:else/>
                <exp:if test="r.isRank">
                    <label sizen="4 4" scale="0.75" halign="right" valign="center" style="TextRaceChat" textcolor="fff" text="{r.rank}"/>
                    <label posn="0.75 0 1.0E-5" sizen="14 5" scale="0.75" halign="left" valign="center" style="TextRaceChat" textcolor="ff0" text="{r.value}"/>
                    <label posn="9 0 2.0E-5" sizen="29 4" scale="0.75" halign="left" valign="center" style="TextRaceChat" textcolor="fff" text="{r.nickname}"/>
                <exp:else/>
                    <label sizen="4 4" scale="0.75" halign="right" valign="center" style="TextRaceChat" textcolor="fff" text="{r.rank}"/>
                    <label posn="13 0 1.0E-5" sizen="28 4" scale="0.75" halign="left" valign="center" style="TextRaceChat" textcolor="fff" text="{r.nickname}"/>
                    <label posn="1 0 2.0E-5" sizen="14 5" scale="0.75" halign="left" valign="center" style="TextRaceChat" textcolor="ff0" text="{r.value}"/>
                </exp:if>
            </exp:if>
        </frame>
        </exp:foreach>
    </frame>
</frame>
