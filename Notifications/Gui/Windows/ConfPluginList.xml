<frame posn="0 -2 1">
    <frame id="Pager" scriptevents="1">
        <exp:foreach items="plugins" as="plugin">
        <exp:checkbox name="{plugin.name}" active="{plugin.active}" textWidth="60" text="{plugin.text}"/>
        </exp:foreach>
    </frame>
    <exp:pager sizeX="97" sizeY="92" itemSizeY="6"/>
</frame>
<frame posn="50 -3 1">
	<exp:button sizeX="30" sizeY="5" text="@Save" action="{closeAction}" isTextId="true"/>
</frame>
