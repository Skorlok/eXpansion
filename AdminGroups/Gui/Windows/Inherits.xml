<frame id="Pager" scriptevents="1">
    <exp:foreach items="groups" as="group" index="n">
    <frame>
        <exp:listbg indexNumber="{n}" sizeX="74" sizeY="4"/>
        <frame posn="0 0 1">
            <exp:checkbox name="cb_{group.name}" active="{group.active}" textWidth="60" text="{group.text}"/>
        </frame>
    </frame>
    </exp:foreach>
</frame>
<exp:pager sizeX="78" sizeY="88" itemSizeY="4"/>
<frame posn="32 -95 1">
    <exp:button sizeX="32" sizeY="6" text="@OK" action="exp:eXpansion.AdminGroups:inheritsOk:{groupName}" isTextId="true"/>
</frame>
